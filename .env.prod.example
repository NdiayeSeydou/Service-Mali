# Copy to .env.prod on the server. Keep the real file out of Git.
DOMAIN=services.example.com
DJANGO_SECRET_KEY=replace-with-a-generated-unique-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=services.example.com
CSRF_TRUSTED_ORIGINS=https://services.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
FRONTEND_URL=https://services.example.com
CORS_ALLOWED_ORIGINS=https://services.example.com

POSTGRES_DB=mali_services
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-long-random-password

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@services.example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Keep mobile money sandboxed until live-provider integrations are implemented.
PAYMENT_MODE=sandbox
PAYMENT_WAVE_WEBHOOK_SECRET=replace-with-a-random-secret
PAYMENT_ORANGE_WEBHOOK_SECRET=replace-with-a-random-secret

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr
